// Small coastal surf, inspired by Tidewater's shoaling / bore / swash stages.
// Rest xz coordinates drive both sand wetness and water, never screen UVs.
uniform float beach_time = 0.0;
float beach_coast(float z) { return -9.0+2.0*sin(z*.055)+.8*sin(z*.17); }
float beach_phase(float d,float z) {
 // Travel time grows with sqrt(depth): crests slow down and bunch near shore.
 return 2.65*(sqrt(max(d,0.0)+1.2)-sqrt(1.2))+beach_time*1.05+z*.018+.26*sin(z*.41)+.12*sin(z*.79+1.2);
}
float beach_runup(float z) {
 // Fast uprush followed by a longer draining backwash, with a quiet interval.
 float cycle=fract((beach_phase(0.0,z)-1.55)*.159154943);
 float rise=clamp(cycle/.32,0.0,1.0);
 float fall=clamp((cycle-.32)/.60,0.0,1.0);
 float pulse=cycle<.32?1.0-pow(1.0-rise,2.0):pow(1.0-fall,1.5);
 return .12+1.65*pulse*(.86+.14*sin(z*.37));
}
vec3 beach_wave(float d,float z) {
 float phase=beach_phase(d,z);
 float amp=(.11+.24*smoothstep(.2,4.5,d))*(1.0-.62*smoothstep(14.0,55.0,d));
 float envelope=smoothstep(.1,2.0,d);
 float height=amp*(sin(phase)+.28*sin(2.0*phase))*envelope;
 float slope=amp*(cos(phase)+.56*cos(2.0*phase))*1.325/sqrt(max(d,0.0)+1.2)*envelope;
 float breaker=smoothstep(.65,.94,sin(phase))*smoothstep(.4,1.5,d)*(1.0-smoothstep(5.0,12.0,d));
 return vec3(height,slope,breaker);
}

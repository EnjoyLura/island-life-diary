// Two numeric samples replace 4/8 painted colour samples.
uniform sampler2D ocean_data : filter_linear_mipmap, repeat_enable;
uniform float chart_mode = 0.0;
uniform float home_mode = 0.0;
uniform float fishing_mode = 0.0;
// xyz points toward an orthographic camera; w=0 selects perspective instead.
uniform vec4 water_view = vec4(0.0,1.0,0.0,0.0);
varying vec3 water_normal;
varying float water_crest;
// Stage built-ins are only available inside vertex()/fragment() in UrhoX.
// Pass camera/varying values explicitly so the shared helper parses on all backends.
vec4 water_light(vec3 position,vec3 base_normal,float crest_height,vec3 camera_position,
                 float depth,out vec2 foam_data) {
    vec2 p=position.xz;
    vec4 a=texture(ocean_data,p*.045+vec2(-ocean_time*.007,-ocean_time*.004));
    // Rotate both the fine sample coordinates and its slopes back to world XZ.
    vec2 rotated=vec2(.8*p.x-.6*p.y,.6*p.x+.8*p.y);
    vec4 b=texture(ocean_data,rotated*.113+vec2(ocean_time*.004,-ocean_time*.008));
    vec2 fine=b.rg-.5;
    fine=vec2(.8*fine.x+.6*fine.y,-.6*fine.x+.8*fine.y);
    // Screen footprint works for both zoomable ortho views and the fishing horizon.
    // Unresolved ripples broaden the highlight instead of flickering or going flat.
    float footprint=length(fwidth(p));
    float fine_detail=1.0-smoothstep(.08,.55,footprint);
    float broad_detail=1.0-smoothstep(.35,1.8,footprint);
    vec2 ripple=((a.rg-.5)*.20*broad_detail+fine*.085*fine_detail)*(.7+a.b*.6);
    vec3 n=normalize(base_normal+vec3(ripple.x,0.0,ripple.y));
    vec3 view=water_view.xyz;
    if(water_view.w<.5) { view=normalize(camera_position-position); }
    float facing=clamp(dot(n,view),0.0,1.0);
    float f=1.0-facing;float f2=f*f;
    float fresnel=.025+.70*f2*f2*f;
    vec3 reflected=reflect(-view,n);
    vec3 sky=mix(vec3(.52,.76,.91),vec3(.16,.45,.77),clamp(reflected.y,0.0,1.0));
    // Broad swell relief remains readable from above, where Fresnel is subtle.
    float shade=clamp(.55+dot(n.xz,vec2(-1.2,-.45))+crest_height*.38,0.0,1.0);
    vec3 blue=mix(vec3(.018,.29,.60),vec3(.025,.445,.77),shade);
    // Clear turquoise shelves converge to the deep material before the mesh seam.
    float shallow=1.0-smoothstep(1.0,19.0,depth);
    blue=mix(blue,vec3(.035,.57,.64),shallow*.48);
    float transmission=max(crest_height,0.0)*(1.0-facing)*broad_detail;
    blue+=vec3(.0,.075,.045)*transmission;
    blue=mix(blue,sky,fresnel);
    vec3 half_light=normalize(view+normalize(vec3(-.45,.75,.40)));
    float roughness=mix(.18,.30,1.0-fine_detail);
    float r2=roughness*roughness;
    float nh=max(dot(n,half_light),0.0);
    float lobe=1.0+nh*nh*(r2-1.0);
    float glint=min(.28,.008*r2/(lobe*lobe));
    // Sparse broken crest highlights, tied to geometry, never travelling stripes.
    foam_data=vec2(a.a*.65+b.a*.35,a.b);
    float noise_width=max(.035,fwidth(foam_data.x));
    float crest=smoothstep(.23,.40,crest_height)
        *smoothstep(.57-noise_width,.66+noise_width,foam_data.x)*broad_detail;
    float foam=crest*.15*(1.0-chart_mode*.65)*(1.0-home_mode*.5);
    blue=mix(blue,vec3(.85,.96,1.0),foam);
    return vec4(clamp(blue+vec3(glint),vec3(0.0),vec3(1.0)),fresnel);
}

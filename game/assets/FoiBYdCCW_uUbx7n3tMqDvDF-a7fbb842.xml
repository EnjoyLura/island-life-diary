<!-- Minimal forward path. Opaque geometry writes one readable depth buffer;
     a full-screen depth copy makes screenread sampling safe during depth test.
     Bindings follow EngineRes/RenderPaths/CEMapDeferredMobile.xml. -->
<renderpath>
    <rendertarget name="depth" sizedivisor="1 1" format="readabledepth" />
    <rendertarget name="depth_buffer" sizedivisor="1 1" format="r32f" />
    <command type="clear" color="fog" depth="1.0" stencil="0" depthstencil="depth" />
    <command type="scenepass" pass="base" vertexlights="true" metadata="base" depthstencil="depth" />
    <command type="forwardlights" pass="light" depthstencil="depth" />
    <command type="scenepass" pass="postopaque" depthstencil="depth" />
    <command type="quad" tag="CrescentDepthCopy" vs="ScreenSpace/CopyTexture" ps="ScreenSpace/CopyTexture" psdefines="COPY_DEPTH HIGH_PRECISION_OUTPUT=1" disableDepthStencilRT="true">
        <texture unit="0" name="depth" />
        <output index="0" name="depth_buffer" />
    </command>
    <command type="scenepass" pass="screenread" sort="backtofront" renderMask="7" depthstencil="depth">
        <texture unit="1" name="depth_buffer" />
    </command>
    <command type="scenepass" pass="alpha" vertexlights="true" sort="backtofront" metadata="alpha" depthstencil="depth" />
    <command type="scenepass" pass="postalpha" sort="backtofront" depthstencil="depth" />
</renderpath>

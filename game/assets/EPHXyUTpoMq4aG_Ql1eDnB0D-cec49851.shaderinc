// Shared, map-registered coast field for water AND wet beach run-up.
uniform sampler2D shore_data : hint_default_white, filter_linear, repeat_disable;
uniform vec4 shore_bounds = vec4(-300.0,-300.0,2600.0,4360.0);
uniform float ocean_time = 0.0;
float home_hash(vec2 p) {
    return fract(sin(dot(p,vec2(127.1,311.7)))*43758.5453);
}
float home_noise(vec2 p) {
    vec2 i=floor(p),f=fract(p);f=f*f*(3.0-2.0*f);
    return mix(mix(home_hash(i),home_hash(i+vec2(1.0,0.0)),f.x),
               mix(home_hash(i+vec2(0.0,1.0)),home_hash(i+vec2(1.0)),f.x),f.y);
}
float home_distance(vec2 p) {
    vec2 uv=(p-shore_bounds.xy)/shore_bounds.zw;
    vec2 rg=texture(shore_data,clamp(uv,vec2(0.0),vec2(1.0))).rg;
    float d=dot(rg,vec2(65280.0,255.0))/65535.0*2048.0-512.0;
    float outside=max(max(-uv.x,uv.x-1.0),max(-uv.y,uv.y-1.0));
    return mix(d,800.0,step(0.0001,outside));
}
// A broken front moves inward and crosses onto wet sand before fading out.
// Noise shifts different coves in time; it never paints parallel offshore lines.
float home_surf(vec2 p,float d) {
    float offset=home_noise(p/210.0)*0.34;
    float phase=fract(ocean_time/5.6+offset);
    float life=smoothstep(0.0,0.13,phase)*(1.0-smoothstep(0.76,1.0,phase));
    float front=mix(48.0,-13.0,smoothstep(0.05,0.92,phase));
    float width=max(2.8+phase*1.8,fwidth(d)*0.8);
    float crest=exp(-2.0*pow((d-front)/width,2.0));
    float trail=exp(-2.0*pow((d-front-7.0)/9.0,2.0))*0.16;
    float lace=smoothstep(0.32,0.67,home_noise(p/9.0+vec2(ocean_time*.12,-ocean_time*.17)));
    float zone=smoothstep(-18.0,-9.0,d)*(1.0-smoothstep(54.0,65.0,d));
    return (crest+trail)*life*mix(0.07,1.0,lace)*zone;
}
